# NETWATCH configuration — copy to .env if you need to override defaults.
# No secrets are used by this project. All values below are optional.

# Directory for runtime snapshot/state files (default: /tmp on Linux)
NETWATCH_TMPDIR=/tmp
# NOTE: Python does not auto-load .env — export these in your shell (or prefix commands) to override.
# Unix control socket used by Flask -> topology experiment commands
NETWATCH_CONTROL_SOCKET=/tmp/sdn_control.sock
# Group allowed to use the control socket
SDN_IPC_GROUP=sdn-ipc
# Topology PID file (set by run_system.sh)
NETWATCH_TOPOLOGY_PID_FILE=/tmp/netwatch_topology.pid
# Keep previous runtime snapshots/logs on startup (1 = keep, default 0 = clean start)
NETWATCH_PRESERVE_RUNTIME_STATE=0
# SQLite retention
NETWATCH_RAW_RETENTION_HOURS=4
NETWATCH_ROLLUP_RETENTION_DAYS=7
NETWATCH_INCIDENT_RETENTION_DAYS=14
NETWATCH_COMPLETED_FLOW_HOURS=24
